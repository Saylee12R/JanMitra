# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://janmitra:janmitra_pass@localhost:5432/janmitra_db

# ─── AI / Gemini ────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=
AI_MODEL=gemini-2.0-flash

# ─── Government Data APIs ────────────────────────────────────────────────────
# data.gov.in  →  https://data.gov.in/
DATA_GOV_API_KEY=

# API Setu  →  https://www.apisetu.gov.in/
API_SETU_KEY=

# myScheme  →  https://www.myscheme.gov.in/
MY_SCHEME_API_KEY=

# ─── JWT / Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ─── App ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
